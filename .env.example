# Локально — этот файл копируется в .env.
# На bothost.ru те же строки заводятся в панели как переменные окружения
# (они переживают редеплой, в отличие от файлов рядом с ботом).

# Токен бота от @BotFather. На bothost панель кладёт его в API_TOKEN сама —
# там эту строку заводить не нужно.
BOT_TOKEN=

# Подписка Claude Code для ответов бота
CLAUDE_CODE_OAUTH_TOKEN=

# Твой Telegram id — владелец бота
OWNER_ID=

# Группы, где бот отвечает на упоминания, через запятую
ALLOWED_CHATS=

# --- дубль постов в VK и MAX ---

# Канал-источник: дублируются только пересылки ИЗ него.
# Можно указать @username и/или числовой id (-100…).
CROSSPOST_CHANNEL=@neurokean_ch
CROSSPOST_CHANNEL_ID=

# VK: id сообщества и ПОЛЬЗОВАТЕЛЬСКИЙ токен с правом wall+photos.
# Групповой токен не умеет грузить фото на стену — нужен именно пользовательский.
VK_GROUP_ID=
VK_USER_TOKEN=

# MAX: токен бота от @masterbot и id канала, где бот админ
MAX_BOT_TOKEN=
MAX_CHAT_ID=

# Публиковать без подтверждения плюсом (1 — включить). По умолчанию выключено.
CROSSPOST_AUTO=

# Сколько ждать обработки видео на стороне MAX перед отправкой, мс
MAX_VIDEO_WAIT_MS=20000
